    "material-design-lite": "^1.2.1",
    "moment": "^2.30.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "regenerator-runtime": "^0.14.1",
    "rxjs": "^7.8.2",
    "slick-carousel": "^1.6.0",
    "socket.io": "^4.8.3",
