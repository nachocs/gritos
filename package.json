    "babel-register": "^6.23.0",
    "babel-runtime": "",
    "babelify": "^10.0.0",
    "chai": "^6.2.2",
    "chalk": "^4.1.2",
    "classnames": "^2.5.1",
    "core-decorators": "",
    "cross-env": "^10.1.0",
    "css-loader": "^6.8.1",
    "debug": "^4.4.3",
    "eslint": "^9.39.4",
    "eslint-plugin-babel": "^5.3.1",
    "exports-loader": "^0.6.4",
    "html-loader": "^4.0.0",
    "html-webpack-plugin": "^5.5.3",
    "https-proxy-agent": "^5.0.1",
    "less": "^2.7.2",
    "less-loader": "^11.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "mocha": "^2.4.5",
