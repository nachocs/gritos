    "autolinker": "^4.1.5",
    "babel-polyfill": "^6.23.0",
    "backbone": "^1.6.1",
    "backbone-fetch-cache": "^2.0.1",
    "bootstrap": "^3.4.1",
    "core-js": "^3.49.0",
    "facebook-sdk-promise": "^1.2.1",
    "font-awesome": "^4.7.0",
    "html-entities": "^2.6.0",
