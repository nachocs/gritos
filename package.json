{
  "name": "gritos",
  "version": "1.10.10",
  "description": "Grita sin cortarte un pelo",
  "main": "js/app/app.js",
  "scripts": {
    "lint": "eslint .",
    "cleanup": "rm -rf dist",
    "build": "npx cross-env NODE_ENV=production webpack --config ./webpack/webpack.prod.config.js",
    "start": "npm run cleanup && npx cross-env NODE_ENV=development webpack-dev-server --progress --color --config ./webpack/webpack.dev.server.js",
    "deploy": "s3-deploy './dist/**' --cwd './dist/' --region $AWS_REGION --bucket $BUCKET_NAME/$CIRCLE_BUILD_NUM --gzip",
    "tag": "ci/tag.sh",
    "bump-version": "ci/bump-version.sh $OPS_FRONTEND_KEY $CIRCLE_BUILD_NUM",
    "now-build": "npm run build && ns ./dist -n gritos --cmd \"list ./content -s\"",
    "serve": "cross-env NODE_ENV=production ENDPOINTS_ROOT_DOMAIN=gritos.com node ./webpack/webpack.prod.server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+git@github.com:nachocs/gritos.git"
  },
  "author": "Gritos.com",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/nachocs/gritos/issues"
  },
  "homepage": "https://github.com/nachocs/gritos#readme",
  "dependencies": {
    "@babel/core": "^7.29.0",
    "autolinker": "^4.1.5",
    "babel-polyfill": "^6.23.0",
    "backbone": "^1.6.1",
    "backbone-fetch-cache": "^2.0.1",
    "bootstrap": "^3.4.1",
    "facebook-sdk-promise": "^1.2.1",
    "font-awesome": "^4.7.0",
    "html-entities": "^2.6.0",
    "icomoon-free-npm": "0.0.0",
    "intersection-observer": "^0.12.2",
    "jquery": "^3.7.1",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.23",
    "material-design-lite": "^1.2.1",
    "moment": "^2.30.1",
    "requirejs": "^2.3.8",
    "rxjs": "^7.8.2",
    "slick-carousel": "^1.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
